{
  "name": "nasa-explorer",
  "version": "1.0.0",
  "description": "ORRERY — a ray-traced, data-driven NASA solar system explorer that runs entirely in the browser.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "homepage": "https://genovese-felipe.github.io/NASA-APIs-Opus5/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Genovese-Felipe/NASA-APIs-Opus5.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node tools/serve.mjs",
    "serve": "node tools/serve.mjs",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:e2e",
    "lint": "node tools/lint.mjs",
    "validate:locales": "node tools/validate-locales.mjs",
    "validate:data": "node tools/validate-data.mjs",
    "snapshots": "node tools/fetch-snapshots.mjs",
    "stars": "node tools/build-star-catalogue.mjs",
    "screenshots": "node tools/capture-screenshots.mjs",
    "build:site": "node tools/build-site.mjs",
    "build:artifact": "node tools/build-artifact.mjs",
    "check": "npm run lint && npm run validate:locales && npm run validate:data && npm run test:unit"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  },
  "keywords": [
    "nasa",
    "solar-system",
    "webgl2",
    "ray-tracing",
    "orrery",
    "astronomy",
    "open-data",
    "visualization",
    "github-pages"
  ]
}
